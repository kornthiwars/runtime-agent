{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "model-rust AI ops memory",
  "description": "Four MongoDB collections linked by a case document. Secrets (URI/password) never stored in documents.",
  "database": "kb",
  "collections": {
    "prompts": {
      "purpose": "What was invoked (AI prompt / slash command)",
      "fields": {
        "_id": { "type": "ObjectId", "required": true },
        "text": { "type": "string", "required": true, "maxChars": 2000 },
        "title": { "type": "string", "required": true, "maxChars": 120 },
        "tags": { "type": "string[]", "required": true },
        "createdAt": { "type": "Date", "required": true },
        "updatedAt": { "type": "Date", "required": true }
      },
      "example": {
        "text": "/ship",
        "title": "/ship",
        "tags": ["ship"]
      }
    },
    "problems": {
      "purpose": "What went wrong / confusion",
      "fields": {
        "_id": { "type": "ObjectId", "required": true },
        "title": { "type": "string", "required": true, "maxChars": 120 },
        "description": { "type": "string", "required": true, "maxChars": 500 },
        "promptId": { "type": "ObjectId", "required": true, "ref": "prompts._id" },
        "tags": { "type": "string[]", "required": true },
        "createdAt": { "type": "Date", "required": true },
        "updatedAt": { "type": "Date", "required": true }
      },
      "example": {
        "title": "ship without confirm",
        "description": "typed /ship then used another command — unsure if commit happened",
        "promptId": "ObjectId",
        "tags": ["ship", "confirm"]
      }
    },
    "solutions": {
      "purpose": "How to fix (may be long)",
      "fields": {
        "_id": { "type": "ObjectId", "required": true },
        "title": { "type": "string", "required": true, "maxChars": 120 },
        "summary": { "type": "string", "required": true, "maxChars": 200 },
        "body": { "type": "string", "required": false, "maxChars": null },
        "fixSteps": { "type": "string[]", "required": true, "itemMaxChars": 300 },
        "rootCause": { "type": "string", "required": false },
        "verify": { "type": "string", "required": false },
        "tags": { "type": "string[]", "required": true },
        "createdAt": { "type": "Date", "required": true },
        "updatedAt": { "type": "Date", "required": true }
      },
      "example": {
        "title": "need confirm to commit",
        "summary": "slash alone is not consent",
        "body": "",
        "fixSteps": ["check confirm word", "else AWAITING_CONFIRM"],
        "rootCause": "",
        "verify": "",
        "tags": ["ship", "confirm"]
      }
    },
    "cases": {
      "purpose": "Links one prompt + problem + solution (one incident)",
      "fields": {
        "_id": { "type": "ObjectId", "required": true },
        "promptId": { "type": "ObjectId", "required": true, "ref": "prompts._id" },
        "problemId": { "type": "ObjectId", "required": true, "ref": "problems._id" },
        "solutionId": { "type": "ObjectId", "required": true, "ref": "solutions._id" },
        "project": { "type": "string|null", "required": false },
        "source": { "type": "string", "required": true, "enum": ["manual", "chat", "import"] },
        "createdAt": { "type": "Date", "required": true },
        "updatedAt": { "type": "Date", "required": true }
      },
      "example": {
        "promptId": "ObjectId",
        "problemId": "ObjectId",
        "solutionId": "ObjectId",
        "project": "agent-skills",
        "source": "manual"
      }
    },
    "notes": {
      "purpose": "Durable /note memory (decision/constraint/exception/gotcha) — not chat cases",
      "fields": {
        "_id": { "type": "ObjectId", "required": true },
        "project": { "type": "string", "required": true, "pattern": "[a-z0-9-]+" },
        "kind": {
          "type": "string",
          "required": true,
          "enum": ["decision", "constraint", "exception", "gotcha"]
        },
        "title": { "type": "string", "required": true, "maxChars": 120 },
        "body": { "type": "string", "required": true, "maxChars": 4000 },
        "tags": { "type": "string[]", "required": true },
        "expires": { "type": "Date|null", "required": false },
        "createdAt": { "type": "Date", "required": true },
        "updatedAt": { "type": "Date", "required": true }
      },
      "example": {
        "project": "agent-skills",
        "kind": "decision",
        "title": "junctions target parent workspace",
        "body": "- skills/rules install into parent .cursor\n- never write under USERPROFILE",
        "tags": ["install", "cursor"],
        "expires": null
      }
    }
  },
  "relations": {
    "diagram": "prompts ← problems.promptId; cases links promptId + problemId + solutionId; notes is standalone durable memory"
  },
  "cliStub": {
    "file": "examples/stub.json",
    "mapsTo": {
      "prompt": "prompts.text",
      "problem": "problems.description",
      "solutionSummary": "solutions.summary",
      "fixSteps": "solutions.fixSteps",
      "tags": "all.tags",
      "project": "cases.project"
    }
  },
  "noteStub": {
    "file": "examples/note-stub.json",
    "mapsTo": {
      "project": "notes.project",
      "kind": "notes.kind",
      "title": "notes.title",
      "body": "notes.body",
      "tags": "notes.tags",
      "expires": "notes.expires"
    }
  }
}

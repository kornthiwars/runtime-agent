{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "model-rust memory (flat)",
  "description": "Two collections: turns = chat/ops transcript; notes = durable /note. Secrets (URI/password) never stored in documents. Legacy prompts/problems/solutions/cases are obsolete.",
  "database": "model-rust",
  "collections": {
    "turns": {
      "purpose": "One Agent turn or manual ops memory (hooks source=chat, or manual)",
      "fields": {
        "_id": { "type": "ObjectId", "required": true },
        "project": { "type": "string|null", "required": false, "description": "Set by the agent (MODEL-RUST-PROJECT / --project); never hardcoded by hooks" },
        "source": { "type": "string", "required": true, "enum": ["manual", "chat", "import"] },
        "skill": { "type": "string|null", "required": false },
        "prompt": { "type": "string", "required": true, "maxChars": 2000 },
        "summary": { "type": "string", "required": true, "maxChars": 200 },
        "body": { "type": "string", "required": false, "maxChars": 4000 },
        "tags": { "type": "string[]", "required": true },
        "createdAt": { "type": "Date", "required": true },
        "updatedAt": { "type": "Date", "required": true }
      },
      "example": {
        "project": "agent-skills",
        "source": "chat",
        "skill": "ship",
        "prompt": "/ship ยืนยัน",
        "summary": "committed and pushed v2.2.0",
        "body": "commit 8a5cd65 → origin/main",
        "tags": ["ship", "auto"]
      }
    },
    "notes": {
      "purpose": "Durable /note memory (decision/constraint/exception/gotcha) — not chat turns",
      "fields": {
        "_id": { "type": "ObjectId", "required": true },
        "project": { "type": "string", "required": true, "pattern": "[a-z0-9-]+", "description": "Resolved by the agent per /note rules" },
        "kind": {
          "type": "string",
          "required": true,
          "enum": ["decision", "constraint", "exception", "gotcha"]
        },
        "title": { "type": "string", "required": true, "maxChars": 120 },
        "body": { "type": "string", "required": true, "maxChars": 4000 },
        "tags": { "type": "string[]", "required": true },
        "expires": { "type": "Date|null", "required": false },
        "createdAt": { "type": "Date", "required": true },
        "updatedAt": { "type": "Date", "required": true }
      },
      "example": {
        "project": "agent-skills",
        "kind": "decision",
        "title": "junctions target parent workspace",
        "body": "- skills/rules install into parent .cursor\n- never write under USERPROFILE",
        "tags": ["install", "cursor"],
        "expires": null
      }
    }
  },
  "relations": {
    "diagram": "turns ⊥ notes (no FK) — same project string only"
  },
  "cliStub": {
    "file": "examples/turn-stub.json",
    "mapsTo": {
      "prompt": "turns.prompt",
      "summary": "turns.summary",
      "body": "turns.body",
      "skill": "turns.skill",
      "tags": "turns.tags",
      "project": "turns.project",
      "source": "turns.source"
    }
  },
  "noteStub": {
    "file": "examples/note-stub.json",
    "mapsTo": {
      "project": "notes.project",
      "kind": "notes.kind",
      "title": "notes.title",
      "body": "notes.body",
      "tags": "notes.tags",
      "expires": "notes.expires"
    }
  }
}

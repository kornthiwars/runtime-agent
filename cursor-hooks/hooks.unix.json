{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "bash .cursor/hooks/notes-daily.sh beforeSubmitPrompt",
        "timeout": 15
      }
    ],
    "afterAgentResponse": [
      {
        "command": "bash .cursor/hooks/notes-daily.sh afterAgentResponse",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "bash .cursor/hooks/notes-daily.sh stop",
        "timeout": 15
      }
    ]
  }
}

{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/notes-daily.ps1 beforeSubmitPrompt",
        "timeout": 15
      }
    ],
    "afterAgentResponse": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/notes-daily.ps1 afterAgentResponse",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/notes-daily.ps1 stop",
        "timeout": 15
      }
    ]
  }
}
